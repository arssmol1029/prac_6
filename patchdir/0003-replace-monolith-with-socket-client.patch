-class DungeonGameCmd(cmd.Cmd):
-    def __init__(self, game: DungeonGame):
+class MUDClient(cmd.Cmd):
+    def __init__(self, sock: socket.socket):
         super().__init__()
         self.prompt = "> "
-        self._game = game
-
-    def move(self, *, dx: int = 0, dy: int = 0, size: int = 10) -> tuple[int, int]:
-        x, y = self._game._player.move(dx=dx, dy=dy, size=size)
-        self._game.encounter(x, y)
+        self._sock = sock
+        self._r = sock.makefile("r", encoding="utf-8", newline="\n")
+        self._w = sock.makefile("w", encoding="utf-8", newline="\n")
+
+    def _send_recv(self, line: str) -> dict:
+        self._w.write(line + "\n")
+        self._w.flush()
+        raw = self._r.readline()
+        if not raw:
+            raise ConnectionError("server closed connection")
+        return json.loads(raw)
+
+    def _do_move(self, dx: int, dy: int) -> None:
+        data = self._send_recv(f"move {dx} {dy}")
+        if data.get("kind") != "move":
+            return
+        x, y = data["x"], data["y"]
+        print(f"Moved to ({x}, {y})")
+        m = data.get("monster")
+        if m:
+            print(cowsay(message=m["hello"], cow=m["cow"]))
 
     def do_right(self, arg: str) -> None:
-        self.move(dx=1)
+        self._do_move(1, 0)
 
     def do_left(self, arg: str) -> None:
-        self.move(dx=-1)
+        self._do_move(-1, 0)
 
     def do_up(self, arg: str) -> None:
-        self.move(dy=1)
+        self._do_move(0, 1)
 
     def do_down(self, arg: str) -> None:
-        self.move(dy=-1)
+        self._do_move(0, -1)
 
