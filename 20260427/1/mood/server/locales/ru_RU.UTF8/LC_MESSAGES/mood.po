msgid " (replaced existing monster)"
msgstr " (заменён существующий монстр)"

msgid ""
"%(attacker)s attacked %(monster)s with %(weapon)s for %(dealt_hp)s and "
"killed the monster!"
msgstr ""
"%(attacker)s атаковал %(monster)s с %(weapon)s, снято %(dealt_hp)s, монстр "
"убит!"

msgid ""
"%(attacker)s attacked %(monster)s with %(weapon)s for %(dealt_hp)s; "
"%(monster)s has %(remaining_hp)s left."
msgstr ""
"%(attacker)s атаковал %(monster)s с %(weapon)s, снято %(dealt_hp)s; у "
"%(monster)s осталось %(remaining_hp)s."

msgid "%(monster)s moved one cell %(direction)s."
msgstr "%(monster)s переместился на одну клетку %(direction)s."

msgid "%(n)d hit point"
msgid_plural "%(n)d hit points"
msgstr[0] "%(n)d очко"
msgstr[1] "%(n)d очка"
msgstr[2] "%(n)d очков"

msgid "%(user)s disconnected from the MOOD."
msgstr "%(user)s отключился от MOOD."

msgid "%(user)s joined the MOOD."
msgstr "%(user)s присоединился к MOOD."

msgid "%(user)s left the MOOD."
msgstr "%(user)s покинул MOOD."

msgid ""
"%(user)s placed monster %(monster)s with %(hp)s at (%(x)d, %(y)d)%(suffix)s."
msgstr ""
"%(user)s разместил монстра %(monster)s с %(hp)s в клетке (%(x)d, %(y)d)"
"%(suffix)s."

msgid "%(user)s: %(text)s"
msgstr "%(user)s: %(text)s"

msgid "Invalid command or parameters."
msgstr "Неверная команда или параметры."

msgid "Moved to (%(x)d, %(y)d)"
msgstr "Переход в клетку (%(x)d, %(y)d)"

msgid "Moving monsters: off"
msgstr "Бродячие монстры: выкл"

msgid "Moving monsters: on"
msgstr "Бродячие монстры: вкл"

msgid "No %(monster)s here"
msgstr "Здесь нет %(monster)s"

msgid "Set up locale: %(name)s"
msgstr "Установлена локаль: %(name)s"

msgid "Unknown command: %(cmd)s"
msgstr "Неизвестная команда: %(cmd)s"

msgid "Welcome %(user)s, you are connected to MOOD."
msgstr "Добро пожаловать, %(user)s, вы подключены к MOOD."

